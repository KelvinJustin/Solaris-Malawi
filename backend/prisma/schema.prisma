// ==========================================
// GENERATOR & DATASOURCE CONFIGURATION
// ==========================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMERATIONS
// ==========================================

// Defines the intended use case for a generated One-Time Password (OTP).
enum OtpPurpose {
  EMAIL_VERIFICATION
  LOGIN
}

// Tracks the lifecycle and compliance approval stage of a merchant account.
enum AccountStatus {
  PENDING_SUBMISSION
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

// Identifies the actor responsible for changing a merchant profile or review state.
enum ProfileActorType {
  MERCHANT
  ADMIN
  SYSTEM
}

// Classifies the legal structure of a merchant business entity.
enum BusinessType {
  INDIVIDUAL
  SOLE_TRADER
  PARTNERSHIP
  LIMITED_COMPANY
  NGO
}

// Categorizes KYC / compliance documents uploaded by merchants.
enum DocumentType {
  NATIONAL_ID_FRONT
  NATIONAL_ID_BACK
  BUSINESS_REGISTRATION
  TAX_CERTIFICATE
  PROOF_OF_ADDRESS
  DIRECTOR_ID
}

// Tracks the verification status of an uploaded compliance document.
enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

// Defines administrative roles and permission tiers within the platform.
enum AdminRole {
  SUPER_ADMIN
  COMPLIANCE
  OPERATIONS
  SUPPORT
}

// Tracks whether an admin account is active or suspended.
enum AdminStatus {
  ACTIVE
  SUSPENDED
}

// Tracks the overall financial status of a payment transaction.
enum PaymentStatus {
  CREATED
  PROCESSING
  SUCCEEDED
  FAILED
  PENDING_RECONCILIATION
}

// Tracks the lifecycle state of a hosted checkout session URL.
enum CheckoutSessionStatus {
  ACTIVE
  EXPIRED
  CONSUMED
  REVOKED
}

// Supported mobile money and payment network providers in Malawi.
enum PaymentProvider {
  AIRTEL_MONEY
  TN_MPAMBA    @map("TNM_MPAMBA")
  TEST
  NOWPAYMENTS
}

// Tracks the granular status of an individual payment gateway attempt.
enum PaymentAttemptStatus {
  STARTED
  PROCESSING
  SUCCEEDED
  FAILED
  UNKNOWN
}

enum FeeType {
  ZERO
  PERCENTAGE
  FIXED
  HYBRID
}

enum FeePolicyAuditAction {
  CREATED
  ACTIVATED
  DEACTIVATED
}

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum LedgerNormalBalance {
  DEBIT
  CREDIT
}

enum LedgerAccountStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum LedgerTransactionType {
  PAYMENT_CAPTURE
  PROVIDER_SETTLEMENT
}

enum LedgerTransactionStatus {
  PENDING
  POSTED
}

enum LedgerEntryDirection {
  DEBIT
  CREDIT
}

enum SettlementImportStatus {
  IMPORTED
  VALIDATION_FAILED
  DUPLICATE
}

enum SettlementBatchStatus {
  IMPORTED
  VALIDATED
  RECONCILING
  PARTIALLY_RECONCILED
  RECONCILED
  APPROVED
  POSTED
  DISCREPANCY
  REJECTED
}

enum SettlementItemKind {
  PAYMENT
  PROVIDER_FEE
  UNSUPPORTED
  INVALID
}

enum SettlementItemMatchStatus {
  PENDING
  MATCHED
  UNMATCHED
  AMBIGUOUS
  DUPLICATE
  AMOUNT_MISMATCH
  CURRENCY_MISMATCH
  UNSUPPORTED
  INVALID
  NOT_APPLICABLE
}

enum BankStatementImportStatus {
  IMPORTED
  VALIDATION_FAILED
  DUPLICATE
}

enum BankStatementLineStatus {
  VALID
  VALIDATION_FAILED
  DUPLICATE
}

enum SettlementAllocationStatus {
  ACTIVE
  REVERSED
}

enum SettlementAuditEventType {
  PROVIDER_IMPORT_CREATED
  BANK_IMPORT_CREATED
  ITEM_MATCHED
  ITEM_UNMATCHED
  BANK_ALLOCATION_CREATED
  BANK_ALLOCATION_REVERSED
  BATCH_APPROVED
  BATCH_POSTED
}

// ==========================================
// CORE DOMAIN MODELS
// ==========================================

// Auth identity only. Business details → MerchantProfile, balances → MerchantLedger.
model Merchant {
  id              String    @id @default(uuid()) @db.Uuid
  name            String
  email           String    @unique
  passwordHash    String
  phone           String    @unique
  pinHash         String?
  emailVerifiedAt DateTime?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  otpChallenges       OtpChallenge[]
  revokedTokens       RevokedToken[]
  profile             MerchantProfile?
  ledger              MerchantLedger?
  paymentTransactions PaymentTransaction[]
  feePolicies         FeePolicy[]
  ledgerAccounts      LedgerAccount[]

  @@map("merchants")
}

// Amounts are stored in integer tambala (1 MWK = 100 tambala).
// Successful confirmation posts a provider receivable and pending merchant payable; cash settlement is separate.
model PaymentTransaction {
  id                 String           @id @default(uuid()) @db.Uuid
  publicReference    String           @unique // Solaris-generated; never expose the DB id externally.
  merchantId         String           @db.Uuid
  // Amount stored in the smallest MWK unit: 100 tambala = MWK 1.00.
  amountTambala      Int              @map("amount")
  currency           String           @default("MWK")
  feeTambala         BigInt           @default(0)
  merchantNetTambala BigInt
  feeType            FeeType          @default(ZERO)
  feePercentageBps   Int              @default(0)
  feeFixedTambala    BigInt           @default(0)
  feePolicyId        String           @db.Uuid
  feePolicyVersion   Int
  status             PaymentStatus    @default(CREATED)
  provider           PaymentProvider? // Null until a provider is selected.
  providerReference  String?
  customerPhone      String?
  description        String?
  merchantReference  String?
  idempotencyKey     String // Deduplicates retried requests; scoped per merchant.

  // Sanitised diagnostics only — never store credentials or tokens here.
  failureCode    String?
  failureMessage String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  processedAt DateTime?

  merchant         Merchant                 @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  attempts         PaymentAttempt[]
  checkoutSessions CheckoutSession[]
  feePolicy        FeePolicy                @relation(fields: [feePolicyId], references: [id], onDelete: Restrict)
  settlementItems  ProviderSettlementItem[]

  @@unique([merchantId, idempotencyKey])
  @@unique([provider, providerReference])
  @@index([merchantId, createdAt])
  @@index([status, createdAt])
  @@index([merchantId, merchantReference])
  @@map("payment_transactions")
}

// One row per provider call. Attempts are never overwritten so the full
// call history is preserved even when a transaction is retried.
model PaymentAttempt {
  id                String               @id @default(uuid()) @db.Uuid
  transactionId     String               @db.Uuid
  attemptNumber     Int
  provider          PaymentProvider
  status            PaymentAttemptStatus @default(STARTED)
  providerReference String?
  failureCode       String?
  failureMessage    String?
  startedAt         DateTime             @default(now())
  completedAt       DateTime?
  cryptoDetail      CryptoPaymentDetail?

  transaction PaymentTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@unique([transactionId, attemptNumber])
  @@index([provider, providerReference])
  @@index([status, startedAt])
  @@map("payment_attempts")
}

// Privileged platform identity. Provisioned internally — no public registration.
model Admin {
  id           String      @id @default(uuid()) @db.Uuid
  name         String
  email        String      @unique
  passwordHash String
  role         AdminRole   @default(SUPPORT)
  status       AdminStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  deletedAt    DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  approvedProfiles              MerchantProfile[]          @relation("ProfileApprovedBy")
  reviewedDocuments             MerchantDocument[]         @relation("DocumentReviewedBy")
  adminRevokedTokens            AdminRevokedToken[]
  providerSettlementImports     ProviderSettlementImport[] @relation("ProviderSettlementImportActor")
  bankStatementImports          BankStatementImport[]      @relation("BankStatementImportActor")
  settlementApprovals           ProviderSettlementBatch[]  @relation("SettlementBatchApprover")
  settlementAllocations         SettlementBankAllocation[] @relation("SettlementAllocationActor")
  settlementAllocationReversals SettlementBankAllocation[] @relation("SettlementAllocationReverser")
  settlementAuditEvents         SettlementAuditEvent[]

  @@index([role, status])
  @@map("admins")
}

// Manages short-lived verification and authentication OTP challenges for merchants.
model OtpChallenge {
  id         String     @id @default(uuid()) @db.Uuid
  merchantId String     @db.Uuid
  purpose    OtpPurpose
  codeHash   String
  expiresAt  DateTime
  attempts   Int        @default(0)
  sentAt     DateTime   @default(now())
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, purpose, consumedAt])
  @@index([expiresAt])
  @@map("otp_challenges")
}

// Blacklist store for revoked merchant JWT refresh/access tokens (identified by jti).
model RevokedToken {
  id         String   @id @default(uuid()) @db.Uuid
  jti        String   @unique @db.Uuid
  merchantId String   @db.Uuid
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("revoked_tokens")
}

// Separate table so admin token revocations are isolated from merchant ones.
model AdminRevokedToken {
  id        String   @id @default(uuid()) @db.Uuid
  jti       String   @unique @db.Uuid
  adminId   String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId])
  @@index([expiresAt])
  @@map("admin_revoked_tokens")
}

// Created automatically on registration but starts empty.
// Only admins may advance accountStatus past SUBMITTED.
model MerchantProfile {
  id         String @id @default(uuid()) @db.Uuid
  merchantId String @unique @db.Uuid

  businessName           String?
  tradingName            String?
  businessType           BusinessType?
  businessRegistrationNo String?
  taxIdentificationNo    String? // MRA TPIN
  merchantCategoryCode   String? // ISO 18245 MCC e.g. "5411"
  industryDescription    String?

  supportEmail String?
  supportPhone String?
  websiteUrl   String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  district     String?
  country      String  @default("MW")

  logoUrl String?

  accountStatus   AccountStatus @default(PENDING_SUBMISSION)
  rejectionReason String?
  submittedAt     DateTime?
  approvedAt      DateTime?
  approvedById    String?       @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  merchant        Merchant                 @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  approvedBy      Admin?                   @relation("ProfileApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  documents       MerchantDocument[]
  reviewHistory   MerchantReviewHistory[]
  documentUploads MerchantDocumentUpload[]

  @@map("merchant_profiles")
}

// Each uploaded file is its own row. Multiple documents of the same type
// are allowed; use supersededByDocumentId to track which is current.
model MerchantDocument {
  id            String         @id @default(uuid()) @db.Uuid
  profileId     String         @db.Uuid
  type          DocumentType
  status        DocumentStatus @default(PENDING)
  fileUrl       String
  fileKey       String
  mimeType      String
  fileSizeBytes Int
  rejectionNote String?
  reviewedAt    DateTime?
  reviewedById  String?        @db.Uuid
  expiresAt     DateTime?
  uploadedAt    DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  supersededAt           DateTime?
  supersededByDocumentId String?   @db.Uuid

  profile    MerchantProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  reviewedBy Admin?          @relation("DocumentReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  supersededBy MerchantDocument?  @relation("DocumentSupersession", fields: [supersededByDocumentId], references: [id], onDelete: SetNull)
  supersedes   MerchantDocument[] @relation("DocumentSupersession")

  @@index([profileId, type])
  @@index([status])
  @@index([supersededByDocumentId])
  @@map("merchant_documents")
}

// Append-only audit log of every accountStatus transition. Never mutate rows.
model MerchantReviewHistory {
  id         String           @id @default(uuid()) @db.Uuid
  profileId  String           @db.Uuid
  fromStatus AccountStatus
  toStatus   AccountStatus
  note       String?
  actorType  ProfileActorType
  actorId    String?          @db.Uuid
  createdAt  DateTime         @default(now())

  profile MerchantProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
  @@index([actorType, actorId])
  @@map("merchant_review_history")
}

// Balances in integer tambala (1 MWK = 100 tambala).
// availableBalance = settled funds; pendingBalance = not yet settled.
model FeePolicy {
  id                 String   @id @default(uuid()) @db.Uuid
  merchantId         String?  @db.Uuid
  type               FeeType
  percentageBps      Int      @default(0)
  fixedAmountTambala BigInt   @default(0)
  currency           String   @db.VarChar(3)
  version            Int
  active             Boolean  @default(true)
  source             String
  createdAt          DateTime @default(now())

  merchant    Merchant?             @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  payments    PaymentTransaction[]
  auditEvents FeePolicyAuditEvent[]

  @@index([merchantId, currency, active])
  @@map("fee_policies")
}

model FeePolicyAuditEvent {
  id         String               @id @default(uuid()) @db.Uuid
  policyId   String               @db.Uuid
  action     FeePolicyAuditAction
  source     String
  occurredAt DateTime             @default(now())

  policy FeePolicy @relation(fields: [policyId], references: [id], onDelete: Restrict)

  @@index([policyId, occurredAt])
  @@map("fee_policy_audit_events")
}

model LedgerAccount {
  id            String              @id @default(uuid()) @db.Uuid
  key           String              @unique
  code          String
  name          String
  type          LedgerAccountType
  normalBalance LedgerNormalBalance
  status        LedgerAccountStatus @default(ACTIVE)
  currency      String              @db.VarChar(3)
  merchantId    String?             @db.Uuid
  provider      PaymentProvider?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  merchant Merchant?             @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  entries  LedgerEntry[]
  balance  LedgerAccountBalance?

  @@index([merchantId, currency])
  @@index([provider, currency])
  @@index([type, status])
  @@map("ledger_accounts")
}

model LedgerAccountBalance {
  id          String   @id @default(uuid()) @db.Uuid
  accountId   String   @unique @db.Uuid
  debitTotal  BigInt   @default(0)
  creditTotal BigInt   @default(0)
  updatedAt   DateTime @updatedAt

  account LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@map("ledger_account_balances")
}

model LedgerTransaction {
  id             String                  @id @default(uuid()) @db.Uuid
  reference      String                  @unique
  sourceType     String
  sourceId       String
  postingPurpose String
  type           LedgerTransactionType
  status         LedgerTransactionStatus @default(PENDING)
  currency       String                  @db.VarChar(3)
  description    String?
  provenance     String?
  backfilledAt   DateTime?
  createdAt      DateTime                @default(now())
  postedAt       DateTime?

  entries         LedgerEntry[]
  settlementBatch ProviderSettlementBatch?

  @@unique([sourceType, sourceId, postingPurpose])
  @@index([type, status, createdAt])
  @@map("ledger_transactions")
}

model LedgerEntry {
  id                  String               @id @default(uuid()) @db.Uuid
  ledgerTransactionId String               @db.Uuid
  accountId           String               @db.Uuid
  direction           LedgerEntryDirection
  amountTambala       BigInt
  createdAt           DateTime             @default(now())

  ledgerTransaction LedgerTransaction @relation(fields: [ledgerTransactionId], references: [id], onDelete: Restrict)
  account           LedgerAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt])
  @@index([ledgerTransactionId])
  @@map("ledger_entries")
}

model BankAccount {
  id        String   @id @default(uuid()) @db.Uuid
  reference String   @unique
  name      String
  currency  String   @db.VarChar(3)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statementImports BankStatementImport[]
  statementLines   BankStatementLine[]

  @@map("bank_accounts")
}

model ProviderSettlementImport {
  id                       String                 @id @default(uuid()) @db.Uuid
  provider                 PaymentProvider
  providerAccountReference String
  sourceFileName           String
  sourceFileChecksum       String
  sourceObjectKey          String
  formatIdentifier         String
  status                   SettlementImportStatus @default(IMPORTED)
  importedById             String                 @db.Uuid
  importedAt               DateTime               @default(now())
  validationErrors         Json?

  importedBy Admin                     @relation("ProviderSettlementImportActor", fields: [importedById], references: [id], onDelete: Restrict)
  batches    ProviderSettlementBatch[]

  @@unique([provider, providerAccountReference, sourceFileChecksum])
  @@index([provider, importedAt])
  @@index([status, importedAt])
  @@map("provider_settlement_imports")
}

model ProviderSettlementBatch {
  id                       String                @id @default(uuid()) @db.Uuid
  importId                 String                @db.Uuid
  provider                 PaymentProvider
  providerAccountReference String
  providerBatchReference   String
  currency                 String                @db.VarChar(3)
  reportPeriodStart        DateTime?
  reportPeriodEnd          DateTime?
  providerClosedAt         DateTime?
  grossAmountTambala       BigInt
  providerFeeAmountTambala BigInt
  expectedNetAmountTambala BigInt
  status                   SettlementBatchStatus @default(IMPORTED)
  validationErrors         Json?
  approvedAt               DateTime?
  approvedById             String?               @db.Uuid
  postedAt                 DateTime?
  ledgerTransactionId      String?               @unique @db.Uuid
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  import            ProviderSettlementImport   @relation(fields: [importId], references: [id], onDelete: Restrict)
  approvedBy        Admin?                     @relation("SettlementBatchApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  ledgerTransaction LedgerTransaction?         @relation(fields: [ledgerTransactionId], references: [id], onDelete: Restrict)
  items             ProviderSettlementItem[]
  bankAllocations   SettlementBankAllocation[]

  @@unique([provider, providerAccountReference, currency, providerBatchReference])
  @@index([status, createdAt])
  @@index([provider, providerClosedAt])
  @@map("provider_settlement_batches")
}

model ProviderSettlementItem {
  id                       String                    @id @default(uuid()) @db.Uuid
  batchId                  String                    @db.Uuid
  sourceRowIdentity        String
  providerRecordReference  String?
  providerPaymentReference String?
  recordKind               SettlementItemKind
  reportedStatus           String?
  settlementConfirmed      Boolean                   @default(false)
  grossAmountTambala       BigInt?
  providerFeeAmountTambala BigInt?
  currency                 String?                   @db.VarChar(3)
  matchingStatus           SettlementItemMatchStatus @default(PENDING)
  matchingMethod           String?
  paymentId                String?                   @db.Uuid
  rawRecord                Json
  validationErrors         Json?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  batch   ProviderSettlementBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  payment PaymentTransaction?     @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([batchId, sourceRowIdentity])
  @@index([providerPaymentReference, matchingStatus])
  @@index([paymentId, matchingStatus])
  @@map("provider_settlement_items")
}

model BankStatementImport {
  id                   String                    @id @default(uuid()) @db.Uuid
  bankAccountId        String                    @db.Uuid
  sourceFileName       String
  sourceFileChecksum   String
  sourceObjectKey      String
  formatIdentifier     String
  statementPeriodStart DateTime?
  statementPeriodEnd   DateTime?
  status               BankStatementImportStatus @default(IMPORTED)
  importedById         String                    @db.Uuid
  importedAt           DateTime                  @default(now())
  validationErrors     Json?

  bankAccount BankAccount         @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  importedBy  Admin               @relation("BankStatementImportActor", fields: [importedById], references: [id], onDelete: Restrict)
  lines       BankStatementLine[]

  @@unique([bankAccountId, sourceFileChecksum])
  @@index([status, importedAt])
  @@map("bank_statement_imports")
}

model BankStatementLine {
  id                             String                  @id @default(uuid()) @db.Uuid
  importId                       String                  @db.Uuid
  bankAccountId                  String                  @db.Uuid
  sourceRowIdentity              String
  bankReference                  String?
  description                    String?
  transactionDate                DateTime
  valueDate                      DateTime?
  creditAmountTambala            BigInt                  @default(0)
  debitAmountTambala             BigInt                  @default(0)
  currency                       String                  @db.VarChar(3)
  status                         BankStatementLineStatus @default(VALID)
  duplicateOfBankStatementLineId String?                 @db.Uuid
  rawRecord                      Json
  validationErrors               Json?
  createdAt                      DateTime                @default(now())

  import      BankStatementImport        @relation(fields: [importId], references: [id], onDelete: Restrict)
  bankAccount BankAccount                @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  duplicateOf BankStatementLine?         @relation("BankStatementLineDuplicates", fields: [duplicateOfBankStatementLineId], references: [id], onDelete: Restrict)
  duplicates  BankStatementLine[]        @relation("BankStatementLineDuplicates")
  allocations SettlementBankAllocation[]

  @@unique([importId, sourceRowIdentity])
  @@index([bankAccountId, bankReference])
  @@index([status, transactionDate])
  @@map("bank_statement_lines")
}

model SettlementBankAllocation {
  id                  String                     @id @default(uuid()) @db.Uuid
  batchId             String                     @db.Uuid
  bankStatementLineId String                     @db.Uuid
  amountTambala       BigInt
  idempotencyKey      String                     @unique
  status              SettlementAllocationStatus @default(ACTIVE)
  allocatedById       String                     @db.Uuid
  reversedById        String?                    @db.Uuid
  reversedAt          DateTime?
  reversalReason      String?
  createdAt           DateTime                   @default(now())

  batch             ProviderSettlementBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  bankStatementLine BankStatementLine       @relation(fields: [bankStatementLineId], references: [id], onDelete: Restrict)
  allocatedBy       Admin                   @relation("SettlementAllocationActor", fields: [allocatedById], references: [id], onDelete: Restrict)
  reversedBy        Admin?                  @relation("SettlementAllocationReverser", fields: [reversedById], references: [id], onDelete: Restrict)

  @@index([batchId, status])
  @@index([bankStatementLineId, status])
  @@map("settlement_bank_allocations")
}

model SettlementAuditEvent {
  id            String                   @id @default(uuid()) @db.Uuid
  entityType    String
  entityId      String
  eventType     SettlementAuditEventType
  actorId       String?                  @db.Uuid
  correlationId String?
  reason        String?
  metadata      Json?
  createdAt     DateTime                 @default(now())

  actor Admin? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@map("settlement_audit_events")
}

// Legacy balances are retained for reconciliation only; the new ledger does
// not infer opening balances from these fields.
model MerchantLedger {
  id               String   @id @default(uuid()) @db.Uuid
  merchantId       String   @unique @db.Uuid
  availableBalance Int      @default(0)
  pendingBalance   Int      @default(0)
  currency         String   @default("MWK")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@map("merchant_ledgers")
}

// Stores encrypted payment checkout session tokens and tracks their lifecycle.
model CheckoutSession {
  id             String                @id @default(uuid()) @db.Uuid
  transactionId  String                @db.Uuid
  tokenHash      String                @unique
  tokenEncrypted String
  status         CheckoutSessionStatus @default(ACTIVE)

  expiresAt  DateTime
  consumedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  transaction PaymentTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@index([transactionId, status])
  @@index([status, expiresAt])
  @@map("checkout_sessions")
}

model MerchantDocumentUpload {
  id               String       @id @default(uuid()) @db.Uuid
  profileId        String       @db.Uuid
  type             DocumentType
  objectKey        String       @unique
  expectedMimeType String
  expiresAt        DateTime
  completedAt      DateTime?
  createdAt        DateTime     @default(now())

  profile MerchantProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, expiresAt])
  @@map("merchant_document_uploads")
}

// One row per crypto-paying PaymentAttempt. A side table, not new nullable
// columns on PaymentAttempt — crypto needs a cluster of fields (pay address,
// FX rate used, underpayment tracking) that mean nothing for mobile money,
// and bolting them onto the shared table just gives you a payments table
// that's half NULL depending on provider.
model CryptoPaymentDetail {
  id        String @id @default(uuid()) @db.Uuid
  attemptId String @unique @db.Uuid

  // NOWPayments' own payment id. Join key for the IPN callback and for
  // polling-based reconciliation; globally unique on their side.
  nowpaymentsPaymentId String @unique

  payCurrency String // NOWPayments ticker, e.g. "usdttrc20", "btc"
  payAmount   Decimal @db.Decimal(36, 18)

  // The fiat leg NOWPayments actually priced against — never MWK.
  // Recorded so any settlement discrepancy traces back to "what rate,
  // captured when".
  priceCurrency            String
  priceAmount              Decimal  @db.Decimal(20, 2)
  fxRateMwkToPriceCurrency Decimal  @db.Decimal(20, 8)
  fxRateCapturedAt         DateTime

  paymentAddress String
  network        String? // display-only breakdown of payCurrency, e.g. "TRC20"

  // Mirrors NOWPayments' payment_status string verbatim (waiting, confirming,
  // confirmed, sending, partially_paid, finished, failed, expired, refunded).
  // Stored as raw string — same convention this schema already uses for
  // ProviderSettlementItem.reportedStatus — so a new NOWPayments status
  // doesn't require a migration.
  lastReportedStatus String?
  actuallyPaidAmount Decimal? @db.Decimal(36, 18)

  invoiceExpiresAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  attempt   PaymentAttempt          @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  ipnEvents CryptoPaymentIpnEvent[]

  @@index([lastReportedStatus])
  @@map("crypto_payment_details")
}

// Append-only raw log of every signature-verified IPN we've received.
// Deliberately not deduplicated: NOWPayments resends the same status on
// retry, and two distinct callbacks can legitimately share a status (funds
// trickling in across several partially_paid updates). This is the record
// you replay from in a dispute, independent of what our state machine did
// with it at the time.
model CryptoPaymentIpnEvent {
  id                    String   @id @default(uuid()) @db.Uuid
  cryptoPaymentDetailId String   @db.Uuid
  reportedStatus        String
  actuallyPaidAmount    Decimal? @db.Decimal(36, 18)
  rawPayload            Json
  receivedAt            DateTime @default(now())

  cryptoPaymentDetail CryptoPaymentDetail @relation(fields: [cryptoPaymentDetailId], references: [id], onDelete: Restrict)

  @@index([cryptoPaymentDetailId, receivedAt])
  @@map("crypto_payment_ipn_events")
}
