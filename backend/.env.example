# ============================================================
# SOLARIS MALAWI — ENVIRONMENT CONFIGURATION
# ============================================================
# Setup:
# 1. Copy this file to `.env` in the backend project root.
# 2. Replace placeholders with your local configuration.
# 3. Never commit `.env` or production secrets to Git.
# 4. Keep this example file free of real credentials.
# 5. Restart the API after changing environment variables.
#
# STORAGE PROVIDERS:
# - Local development: MinIO AIStor (S3-compatible)
# - Production: Cloudflare R2
#
# To switch to Cloudflare R2:
# - Remove/comment R2_ENDPOINT.
# - Remove/comment R2_REGION.
# - Remove/comment R2_FORCE_PATH_STYLE.
# - Configure your actual Cloudflare R2 credentials.
# ============================================================


# ------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------

# NestJS API listening port.
PORT=3000

# Runtime environment: development | test | production
NODE_ENV=development


# ------------------------------------------------------------
# DATABASE — POSTGRESQL / PRISMA
# ------------------------------------------------------------

# PostgreSQL connection string.
# Replace credentials and database name as needed.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/Solaris?schema=public"


# ------------------------------------------------------------
# FRONTEND / CORS
# ------------------------------------------------------------

# EXACT origin of the React app (scheme + host + port, NO trailing slash).
# Used as the credentialed-CORS origin, so a mismatch breaks login cookies.
FRONTEND_URL=http://localhost:5173


# ------------------------------------------------------------
# REDIS — CACHE / BACKGROUND JOBS
# ------------------------------------------------------------

# Local development: localhost
# Docker Compose: use the Redis service name, e.g. redis.
REDIS_HOST=localhost
REDIS_PORT=6379

# Uncomment only when Redis authentication is configured.
# REDIS_PASSWORD=replace_with_redis_password


# ------------------------------------------------------------
# PASSWORD SECURITY
# ------------------------------------------------------------

# Bcrypt work factor. Must match the variable name read by your code.
ENCRYPTION_SALT=12


# ------------------------------------------------------------
# JWT AUTHENTICATION
# ------------------------------------------------------------

# Generate a unique secret for each environment.
# Example:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET

# JWT expiration.
JWT_EXPIRES_IN=15m


# ------------------------------------------------------------
# EMAIL DELIVERY — SMTP
# ------------------------------------------------------------

# Local development using Mailpit.
SMTP_SERVER=127.0.0.1
SMTP_PORT=1025

# Mailpit does not require authentication.
SMTP_USER=
SMTP_API_KEY=

# Development-only sender address.
SMTP_FROM="Solaris Malawi <no-reply@Solaris.local>"

# For Brevo, replace the values above with your SMTP configuration.
# SMTP_SERVER=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=YOUR_BREVO_SMTP_LOGIN
# SMTP_API_KEY=YOUR_BREVO_SMTP_KEY
# SMTP_FROM="Solaris Malawi <no-reply@your-domain.com>"


# ------------------------------------------------------------
# EMAIL VERIFICATION & TWO-FACTOR AUTHENTICATION
# ------------------------------------------------------------

# OTP lifetime in seconds.
OTP_TTL_SECONDS=300

# Minimum wait between OTP send/resend requests, in seconds.
OTP_RESEND_COOLDOWN_SECONDS=60

# Maximum incorrect OTP submissions per challenge.
OTP_MAX_ATTEMPTS=5

# Secret used to HMAC OTP values before storing their hashes.
# Generate a separate random secret; do not reuse JWT_SECRET.
# Example:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=REPLACE_WITH_A_SEPARATE_RANDOM_SECRET


# ------------------------------------------------------------
# ARCJET SECURITY CONFIGURATION
# ------------------------------------------------------------

ARCJET_ENV=development

# Obtain your key from https://console.arcjet.com
ARCJET_KEY=REPLACE_WITH_YOUR_ARCJET_KEY


# ------------------------------------------------------------
# OBJECT STORAGE — S3 COMPATIBLE
# ------------------------------------------------------------
#
# The application uses AWS SDK S3Client.
#
# LOCAL DEVELOPMENT — MINIO AISTOR:
# - Endpoint: http://localhost:9000
# - Console: http://localhost:9001
# - Region: us-east-1
# - Path-style addressing: enabled
#
# PRODUCTION — CLOUDFLARE R2:
# - Remove/comment R2_ENDPOINT.
# - Remove/comment R2_REGION.
# - Remove/comment R2_FORCE_PATH_STYLE.
# - Set R2_ACCOUNT_ID to your actual Cloudflare account ID.
# - Set R2_ACCESS_KEY_ID and R2_SECRET_ACCESS_KEY to your R2 credentials.
# - The application constructs the Cloudflare endpoint automatically.


# S3-compatible endpoint.
# Local MinIO: http://localhost:9000
# Production R2: leave unset.
R2_ENDPOINT=http://localhost:9000

# S3 region.
# MinIO: us-east-1
# Cloudflare R2: auto (handled by application default).
R2_REGION=us-east-1

# Enable path-style bucket addressing for MinIO.
# MinIO: true
# Cloudflare R2: remove this variable when switching to production.
R2_FORCE_PATH_STYLE=true

# Local MinIO: placeholder value (not used to construct its endpoint).
# Cloudflare R2: your actual Cloudflare account ID.
R2_ACCOUNT_ID=local-minio

# Local MinIO development credentials.
# Cloudflare R2: replace with your R2 access credentials.
R2_ACCESS_KEY_ID=YOUR_S3_ACCESS_KEY
R2_SECRET_ACCESS_KEY=YOUR_S3_SECRET_KEY

# Bucket must exist in the selected storage provider.
R2_BUCKET_NAME=solaris-kyc-documents


# ------------------------------------------------------------
# HOSTED CHECKOUT & SERVICES
# ------------------------------------------------------------

# Used to encrypt checkout tokens stored in the database.
# Must decode from Base64 to exactly 32 bytes.
# Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
#
# Keep this key stable across deployments. Never commit the real key.
CHECKOUT_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_A_GENERATED_BASE64_KEY

# Base URL used to construct hosted checkout links.
# Local example; use your actual HTTPS domain in production.
CHECKOUT_BASE_URL=http://localhost:3000/v1

# Base URL of the test provider service used for routing API calls.
TEST_PROVIDER_BASE_URL=https://solaris-test-provider.onrender.com

# Secret used for signing webhook payloads or service-to-service requests.
SIGNING_SECRET=REPLACE_WITH_A_SIGNING_SECRET

# API key required by external services or developers to trigger/interact with the simulator.
DEV_API_KEY=REPLACE_WITH_A_DEV_API_KEY


# ============================================================
# END OF CONFIGURATION
# ============================================================